<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Word Redline 2.1" Width="1140" Height="880" MinWidth="980" MinHeight="880"
        WindowStartupLocation="CenterScreen" Background="#F3F5F9" Foreground="#192338"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#24334C"/>
      <Setter Property="BorderBrush" Value="#DCE2EB"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#1D56D0"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="12,8"/><Setter Property="BorderBrush" Value="#D6DEEA"/><Setter Property="Background" Value="White"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#2563EB"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Width="20" Height="20"><Border x:Name="Box" Background="White" BorderBrush="#A7B3C6" BorderThickness="1" CornerRadius="4"/><Path x:Name="Tick" Data="M 5,10 L 9,14 L 15,6" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/></Grid>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#2563EB"/><Setter TargetName="Box" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#101828"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Width="44" Height="24"><Border x:Name="Track" Background="#D2D9E4" CornerRadius="12"/><Ellipse x:Name="Thumb" Width="18" Height="18" Margin="3" Fill="White" HorizontalAlignment="Left"/></Grid>
        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#2563EB"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#192338"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DDE3ED"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="White" BorderBrush="#DDE3ED" BorderThickness="1" CornerRadius="5"><Path Data="M 0,0 L 4,4 L 8,0" Stroke="#63728A" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
            <Border Background="White" BorderBrush="#DDE3ED" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,3,0,0" Padding="4"><ScrollViewer MaxHeight="260"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F8FAFC"/><Setter Property="Foreground" Value="#6B778B"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EDF4FF"/><Setter Property="Foreground" Value="#192338"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="White"/><Setter Property="MinHeight" Value="52"/><Setter Property="BorderBrush" Value="#EFF2F6"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemSurface" Padding="10,5" CornerRadius="5" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#EAF2FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <DataTemplate x:Key="FileRow"><DockPanel ToolTip="{Binding FullPath}"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#6282AB" FontSize="19" Margin="0,3,10,0"/><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12"/><TextBlock Text="{Binding DirectoryName}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="#8390A3" Margin="0,2,0,0"/></StackPanel></DockPanel></DataTemplate>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E7EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/></Style>
  </Window.Resources>
  <Grid Margin="28,20,28,22">
    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="70"/><RowDefinition Height="240"/><RowDefinition Height="48"/><RowDefinition Height="*" MinHeight="145"/><RowDefinition Height="126"/><RowDefinition Height="68"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0">
      <Image x:Name="BrandIcon" Width="40" Height="40" Margin="0,0,12,0"/>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Word Redline" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="每一处修改，都有迹可循" Foreground="#7F8A9D" FontSize="11" Margin="0,3,0,0"/></StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E9EEF8" CornerRadius="12" Padding="12,5"><TextBlock Text="WINDOWS  /  2.1" FontSize="10" Foreground="#657795"/></Border>
    </DockPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="轻松比对，清晰交付。" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="添加新旧文档，确认配对，一键生成带修订标记的版本。" Foreground="#718097" Margin="0,7,0,0"/></StackPanel>
    <Grid Grid.Row="2" Margin="0,8,0,0" IsEnabled="{Binding CanEdit}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="OldDrop" Tag="old" Grid.Column="0" Style="{StaticResource Card}" Padding="18,14" AllowDrop="True">
        <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
          <DockPanel><TextBlock Text="旧版文档" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding OldFiles.Count, StringFormat={}{0} 份}" Foreground="#8090A6" HorizontalAlignment="Right"/></DockPanel>
          <Grid Grid.Row="1" Margin="0,4,0,8">
            <ListBox x:Name="OldList" ItemsSource="{Binding OldFiles}" ItemTemplate="{StaticResource FileRow}" SelectionMode="Extended" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <Border Background="#F8FAFE" CornerRadius="7" BorderBrush="#DCE5F2" BorderThickness="1" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding OldFiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" Foreground="#7397C8" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="拖入旧版文件" Margin="0,8,0,0" Foreground="#627A9B"/></StackPanel></Border>
          </Grid>
          <DockPanel Grid.Row="2"><Button x:Name="AddOld" Content="＋ 添加文件" Padding="12,7"/><Button x:Name="RemoveOld" Content="移除选中" Margin="8,0,0,0" Padding="10,7" Background="Transparent" BorderThickness="0" Foreground="#7C8BA2" HorizontalAlignment="Left"/></DockPanel>
        </Grid>
      </Border>
      <Border x:Name="NewDrop" Tag="new" Grid.Column="2" Style="{StaticResource Card}" Padding="18,14" AllowDrop="True">
        <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
          <DockPanel><TextBlock Text="新版文档" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding NewFiles.Count, StringFormat={}{0} 份}" Foreground="#8090A6" HorizontalAlignment="Right"/></DockPanel>
          <Grid Grid.Row="1" Margin="0,4,0,8">
            <ListBox x:Name="NewList" ItemsSource="{Binding NewFiles}" ItemTemplate="{StaticResource FileRow}" SelectionMode="Extended" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <Border Background="#F8FAFE" CornerRadius="7" BorderBrush="#DCE5F2" BorderThickness="1" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding NewFiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" Foreground="#7397C8" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="拖入新版文件" Margin="0,8,0,0" Foreground="#627A9B"/></StackPanel></Border>
          </Grid>
          <DockPanel Grid.Row="2"><Button x:Name="AddNew" Content="＋ 添加文件" Padding="12,7"/><Button x:Name="RemoveNew" Content="移除选中" Margin="8,0,0,0" Padding="10,7" Background="Transparent" BorderThickness="0" Foreground="#7C8BA2" HorizontalAlignment="Left"/></DockPanel>
        </Grid>
      </Border>
    </Grid>
    <DockPanel Grid.Row="3" VerticalAlignment="Center" Margin="0,6,0,0"><TextBlock Text="确认配对" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding PairSummary}" Foreground="#7B899D" HorizontalAlignment="Right" FontSize="12"/></DockPanel>
    <Border Grid.Row="4" Style="{StaticResource Card}" ClipToBounds="True">
      <Grid>
        <DataGrid x:Name="PairsGrid" ItemsSource="{Binding Pairs}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="White" RowHeaderWidth="0" SelectionMode="Single" IsReadOnly="False" Margin="1,3,1,3">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="44"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="选择此组比对"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn Header="新版文件" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding NewName}" ToolTip="{Binding NewPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn Header="对应旧版 · 可调整" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.OldChoices, RelativeSource={RelativeSource AncestorType=Window}}" SelectedValue="{Binding OldIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Index" DisplayMemberPath="Label" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" Height="34" Margin="8,3" ToolTip="{Binding OldPath}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn Header="状态" Width="175"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding BadgeBackground}" CornerRadius="5" Padding="9,5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="{Binding Status}" Foreground="{Binding BadgeForeground}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="142" ToolTip="{Binding Detail}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,28,0,0" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Pairs.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="配对会显示在这里" HorizontalAlignment="Center" Foreground="#8190A4"/><TextBlock Text="支持多文件批量比对，也可以手动调整对应关系" FontSize="11" Foreground="#A2ADBD" Margin="0,6,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14">
      <Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#6282AB" FontSize="20" Margin="0,0,12,0"/><TextBlock Text="保存到子文件夹" FontWeight="SemiBold" FontSize="14"/></StackPanel>
          <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding UseSubfolder, Mode=TwoWay}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" Margin="10,0,18,0" AutomationProperties.Name="将结果保存到子文件夹"/>
          <TextBox Grid.Column="2" Width="194" Text="{Binding SubfolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanNameFolder}" ToolTip="默认 Legal；只输入一个文件夹名称" AutomationProperties.Name="子文件夹名称"/>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding SaveHint}" FontSize="11" Foreground="{Binding SaveHintColor}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding SaveHint}" Margin="32,6,0,0"/>
      </Grid>
    </Border>
    <Grid Grid.Row="6" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding Message}" Foreground="#68788F" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" FontSize="12"/><ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Margin="0,8,16,0" BorderThickness="0" Foreground="#2563EB" Background="#E4EAF3" Visibility="{Binding ProgressVisibility}"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Clear" Content="清空" Background="Transparent" BorderThickness="0" IsEnabled="{Binding CanEdit}" Margin="0,0,5,0"/><Button x:Name="OpenOutput" Content="打开结果" IsEnabled="{Binding CanOpen}" Margin="0,0,10,0"/><Button x:Name="Cancel" Content="停止比对" Visibility="{Binding BusyVisibility}" Margin="0,0,10,0"/><Button x:Name="Start" Content="开始比对  →" Style="{StaticResource Primary}" IsEnabled="{Binding CanEdit}" MinWidth="140" Height="42"/></StackPanel>
    </Grid>
  </Grid>
</Window>
